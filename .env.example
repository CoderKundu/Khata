# Copy to .env and fill in. Never commit .env.

# Neon Postgres, POOLED connection string — used by the running app.
# The hostname contains "-pooler":
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The same database, DIRECT (unpooled) connection string — used only by the
# Prisma CLI for migrations and seeding. Same string without "-pooler".
# Neon's pooler cannot run the schema changes a migration needs.
DIRECT_URL=

# Razorpay -> Settings -> API Keys. Test mode keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay -> Settings -> Webhooks. The secret YOU type when creating the webhook.
# This is not the API secret above; they are different values.
RAZORPAY_WEBHOOK_SECRET=

# The single password your father types to log in.
ADMIN_PASSWORD=

# Random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shown in the WhatsApp message: "aapka {SHOP_NAME} ka bakaya ..."
NEXT_PUBLIC_SHOP_NAME=
